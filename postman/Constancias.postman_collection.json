              "pm.test(\"Registro disponible\", function () { pm.expect([201,409]).to.include(pm.response.code); });",
              "pm.test(\"Datos del registro\", function () { if (pm.response.code === 201) { pm.expect(pm.response.json().matricula).to.eql(pm.collectionVariables.get(\"matricula\")); pm.expect(pm.response.json().nombre).to.eql(\"Emilio Alejandro Aguirre Tronco\"); } });",
